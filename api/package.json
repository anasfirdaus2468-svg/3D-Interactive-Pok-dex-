{
  "name": "pokedex-auth-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 test/auth.test.js test/config.test.js"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "better-call": "1.4.4",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0"
  }
}
