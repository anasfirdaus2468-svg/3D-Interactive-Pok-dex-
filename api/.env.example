NODE_ENV=development
HOST=127.0.0.1
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
# npm run setup fills this with a random secret in your local .env.
BETTER_AUTH_SECRET=
DATABASE_PATH=./var/auth.sqlite
# Exact frontend origins, comma separated. Leave empty for same-origin use.
TRUSTED_ORIGINS=
# Only set these to the addresses/CIDRs of proxies you operate.
TRUST_PROXY_CIDRS=
SESSION_TTL_SECONDS=604800
